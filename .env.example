# All values are public (NEXT_PUBLIC_*) - no secrets belong in this app.
NEXT_PUBLIC_SITE_URL=https://stellarlend-frontend-tau.vercel.app
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Deployed StellarLend Soroban contract IDs (testnet)
NEXT_PUBLIC_LENDING_CONTRACT_ID=CC4A6A46O2KQA7KEMOFK3TQ4YRSLCJ4ZP26SQWXIKNF4DTEX3BOL2HF6
# Optional Multisig contract ID (validated C-address)
NEXT_PUBLIC_MULTISIG_CONTRACT_ID=
# AMM pool and token contracts (set once deployed).
NEXT_PUBLIC_AMM_CONTRACT_ID=
NEXT_PUBLIC_AMM_TOKEN_A_CONTRACT_ID=
NEXT_PUBLIC_AMM_TOKEN_B_CONTRACT_ID=
# Optional Stellar classic-asset identities in CODE:ISSUER form for trustline display.
NEXT_PUBLIC_AMM_TOKEN_A_HORIZON_ASSET=
NEXT_PUBLIC_AMM_TOKEN_B_HORIZON_ASSET=
# Optional testnet override for maximum acceptable oracle price age in seconds (default: 3600)
NEXT_PUBLIC_ORACLE_MAX_AGE_SECONDS=
# Server-only (not NEXT_PUBLIC_*): number of trusted proxy hops appending to X-Forwarded-For (default: 1; 0 ignores X-Forwarded-For).
TRUSTED_PROXY_HOPS=1
